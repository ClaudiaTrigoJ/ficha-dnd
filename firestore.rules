rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> CAMBIA ESTE CORREO por el del DM (debe entrar con Google) <<<
    function isDM() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['CORREO_DEL_DM@gmail.com'];
    }
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    function maxLevel() {
      return exists(/databases/$(database)/documents/config/main)
        ? get(/databases/$(database)/documents/config/main).data.maxLevel : 1;
    }
    // Nombres de clases y flores: los de la tabla editable del DM (o los iniciales)
    function tnames(f, dflt) {
      return exists(/databases/$(database)/documents/config/tables)
        ? get(/databases/$(database)/documents/config/tables).data[f] : dflt;
    }

    // Sirve para que la app sepa si quien entra es el DM
    match /dmcheck/{x} { allow read: if isDM(); }

    match /config/{d} {
      allow read: if request.auth != null;
      allow write: if isDM();
    }

    match /permits/{uid}/grants/{gid} {
      allow read: if me(uid) || isDM();
      allow write: if isDM();
    }

    match /players/{uid} {
      allow read: if me(uid) || isDM();
      allow create, update: if isDM() || (me(uid)
        && request.resource.data.keys().hasOnly(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40);
      allow delete: if isDM();

      match /chars/{cid} {
        allow read: if me(uid) || isDM();
        allow delete: if isDM();

        // Un personaje por permiso: el id del personaje es el id del permiso
        allow create: if me(uid)
          && exists(/databases/$(database)/documents/permits/$(uid)/grants/$(cid))
          && request.resource.data.grant == cid
          && request.resource.data.extra == get(/databases/$(database)/documents/permits/$(uid)/grants/$(cid)).data.extra
          && request.resource.data.level is int
          && request.resource.data.level >= 1
          && request.resource.data.level <= maxLevel()
          && request.resource.data.cls in tnames('classNames', ['Guerrero','Monje','Clérigo','Bardo','Druida','Tirador','Asesino','Hechicero','Warlock','Mago'])
          && request.resource.data.flower in tnames('flowerNames', ['Flor Roja','Flor Azul','Flor Verde','Flor Marrón','Flor Blanca','Flor Morada','Flor Amarilla'])
          && request.resource.data.pool.size() == 0
          && request.resource.data.done == false;

        allow update: if isDM() || (me(uid) && (ownerOk() || textOk() || iconOk() || spendOk()));

        // Los tres textos del personaje: el jugador puede escribirlos cuando quiera
        function textOk() {
          let k = request.resource.data.diff(resource.data).affectedKeys();
          return k.hasOnly(['trasfondo','profesion','alineamiento','background'])
            && (!k.hasAny(['trasfondo']) || (request.resource.data.trasfondo is string && request.resource.data.trasfondo.size() <= 3000))
            && (!k.hasAny(['profesion']) || (request.resource.data.profesion is string && request.resource.data.profesion.size() <= 3000))
            && (!k.hasAny(['background']) || (request.resource.data.background is string && request.resource.data.background.size() <= 3000))
            && (!k.hasAny(['alineamiento']) || (request.resource.data.alineamiento is string && request.resource.data.alineamiento.size() <= 3000));
        }

        // Foto del personaje: imagen pequeña en texto (data URL jpeg), opcional
        function iconOk() {
          let k = request.resource.data.diff(resource.data).affectedKeys();
          return k.hasOnly(['icon']) && request.resource.data.icon is string
            && request.resource.data.icon.size() <= 60000
            && (request.resource.data.icon == '' || request.resource.data.icon.matches('^data:image/jpeg;base64,.*'));
        }

        function used(d) { return d.hp.r.size() + d.ma.r.size() + d.an.r.size(); }

        // Tiradas: el jugador avanza paso a paso; lo ya tirado no se puede borrar ni cambiar de orden
        function ownerOk() {
          let k = request.resource.data.diff(resource.data).affectedKeys();
          let n = request.resource.data;
          let o = resource.data;
          return k.hasOnly(['pool','sl','hp','ma','an','rw','fin','done'])
            // 1. estadísticas
            && (!k.hasAny(['pool']) || (o.pool.size() == 0 && n.pool.size() == 8 + o.extra))
            && (!k.hasAny(['sl']) || (!('hp' in o) && n.pool.size() > 0 && n.sl.size() == 8))
            // 2. tirada obligatoria (nivel 0) y reparto de dados (nunca más que el nivel)
            && (!k.hasAny(['hp','ma','an']) || (o.sl.size() == 8 && !(-1 in o.sl) && !('rw' in o)
                  && (('hp' in o)
                      ? (n.hp.nb == o.hp.nb && used(n) - n.hp.nb <= o.level
                         && n.hp.r.size() >= o.hp.r.size() && n.ma.r.size() >= o.ma.r.size() && n.an.r.size() >= o.an.r.size())
                      : (k.hasAll(['hp','ma','an']) && n.hp.nb in [0,1,2,3] && used(n) == n.hp.nb
                         && n.hp.r.size() <= 1 && n.ma.r.size() <= 1 && n.an.r.size() <= 1))))
            // 3. recompensas: solo cuando se han usado todos los dados; el nivel 0 da 2 puntos
            && (!k.hasAny(['rw','fin','done']) || (!('rw' in o) && 'hp' in o && used(o) - o.hp.nb == o.level
                  && 5 * n.rw.r.size() == 4 * o.level + o.level % 5
                  && 5 * n.fin.puntos == 2 * (o.level - o.level % 5) + 10));
        }

        // Reparto de puntos de estadística: solo subir estadísticas gastando puntos
        function dd(s) {
          return request.resource.data.fin.stats[s] - resource.data.fin.stats[s];
        }
        function spendOk() {
          let k = request.resource.data.diff(resource.data).affectedKeys();
          let o = resource.data.fin;
          let n = request.resource.data.fin;
          return k.hasOnly(['fin']) && 'fin' in resource.data
            && n.puntos is int && n.puntos >= 0 && n.puntos <= o.puntos
            && n.hp == o.hp && n.mana == o.mana && n.anima == o.anima
            && dd('Fuerza') >= 0 && dd('Constitución') >= 0 && dd('Destreza') >= 0 && dd('Voluntad') >= 0
            && dd('Inteligencia') >= 0 && dd('Carisma') >= 0 && dd('Sabiduría') >= 0 && dd('Suerte') >= 0
            && dd('Fuerza') + dd('Constitución') + dd('Destreza') + dd('Voluntad')
               + dd('Inteligencia') + dd('Carisma') + dd('Sabiduría') + dd('Suerte') == o.puntos - n.puntos;
        }
      }
    }
  }
}
